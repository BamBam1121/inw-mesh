{
	admin off
	auto_https off
	persist_config off
}

# Only reachable from this laptop: Cloudflare's tunnel connects here and carries
# the public traffic for squatchmesh.com. Nothing is opened on the router.
http://:8080 {
	bind 127.0.0.1

	@www host www.squatchmesh.com
	redir @www https://squatchmesh.com{uri} permanent

	# Cloudflare says how the visitor arrived; send plain http to https.
	@insecure header Cf-Visitor *"scheme":"http"*
	redir @insecure https://{host}{uri} permanent

	root * C:/squatchmesh/www
	encode zstd gzip
	# Clean addresses: /install serves install.html.
	try_files {path} {path}.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Browsers only ever use HTTPS for this site from now on.
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		# Scripts only from this site and the ESP Web Tools flasher on unpkg; network
		# calls only to the firmware site and the GitHub releases API. No inline scripts.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://bambam1121.github.io https://api.github.com https://unpkg.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
		# Web Serial (for flashing) only for this site; everything else off.
		Permissions-Policy "serial=(self), usb=(), camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}

	log {
		output file C:/squatchmesh/logs/access.log {
			roll_size 5MiB
			roll_keep 3
		}
	}
}
